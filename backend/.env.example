# Environment variables example for RIMS
DB_URL=jdbc:postgresql://localhost:5432/inventory
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
JWT_SECRET=your_base64_encoded_32_byte_jwt_key_here
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
PORT=8082
# Set these only for first startup to bootstrap the initial SUPER_ADMIN.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
