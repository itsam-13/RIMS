# Copy this file to application-local.yaml and set your local credentials:
# cp application-local.yaml.example application-local.yaml

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/inventory
    username: postgres
    password: your_database_password_here

jwt:
  secret: your_base64_encoded_32_byte_jwt_key_here

# Configure these only for the first application startup to create the root account.
# After it exists, remove these values. They are ignored on later starts.
app:
  bootstrap:
    super-admin:
      username: superAdmin
      email: superAdmin@mail.com
      password: replace_with_a_strong_unique_password
